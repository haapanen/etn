    "example": "tsx examples/chatbot.ts",
    "chat": "tsx src/cli.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
