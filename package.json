{
  "name": "etn",
  "version": "0.1.0",
  "description": "Wolfenstein: Enemy Territory (protocol 84) UDP client library for building bots",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "etn-chat": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
